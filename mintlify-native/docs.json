                "group": "Setup OpenFGA",
                "root": "docs/getting-started/setup-openfga/overview",
                "pages": [
                  "docs/getting-started/setup-openfga/configure-openfga",
                  "docs/getting-started/setup-openfga/configuration",
                  "docs/getting-started/setup-openfga/docker",
                  "docs/getting-started/setup-openfga/kubernetes",
                  "docs/getting-started/setup-openfga/access-control",
                  "docs/getting-started/setup-openfga/playground",
                  "docs/getting-started/setup-openfga/reporting-runtime-issues"
