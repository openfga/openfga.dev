{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "OpenFGA",
  "description": "OpenFGA is a CNCF open source authorization system for fine-grained, relationship-based access control.",
  "logo": {
    "light": "/images/img/openfga_logo.svg",
    "dark": "/images/img/openfga_logo-white.svg",
    "href": "https://openfga.dev/"
  },
  "colors": {
    "primary": "#2c7a3f",
    "light": "#d3ffd7",
    "dark": "#558f69"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "styling": {
    "codeblocks": "dark"
  },
  "background": {
    "color": {
      "dark": "#272b33"
    }
  },
  "favicon": "/images/img/openfga-icon.svg",
  "seo": {
    "metatags": {
      "og:image": "https://openfga.dev/img/og-rich-embed.png"
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/openfga/openfga"
      },
      {
        "label": "Twitter",
        "href": "https://twitter.com/openfga",
        "icon": "twitter"
      },
      {
        "label": "Community",
        "href": "https://openfga.dev/community",
        "icon": "slack"
      }
    ]
  },
  "contextual": {
    "options": ["assistant"]
  },
  "navigation": {
    "tabs": [
