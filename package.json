{
  "name": "openfga.dev",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "docusaurus start --port=${PORT:-3000}",
    "docusaurus": "docusaurus",
    "start": "npm run serve --port=${PORT:-3000}",
    "prebuild": "npm run check:mintlify-deployment && npm run check:mintlify-codegen && npm run validate:mintlify-navigation && npm run check:legacy-api-routes",
    "build": "npm run build:docusaurus && npm run build:agent-content && npm run build:site-sitemap && npm run check:agent-content && npm run check:site-boundary",
    "build:site-sitemap": "node scripts/prepare-site-sitemap.mjs",
    "build:agent-content": "node scripts/prepare-agent-content.mjs",
    "build:docusaurus": "docusaurus build",
    "build:config-page": "node scripts/update-config-page.mjs",
    "test:config-page": "node --test scripts/update-config-page.test.mjs",
    "check:agent-content": "node scripts/validate-agent-content.mjs",
    "check:site-boundary": "node scripts/validate-site-boundary.mjs",
    "test:site-boundary": "node --test scripts/site-boundary.test.mjs scripts/agent-content.test.mjs scripts/site-sitemap.test.mjs scripts/legacy-api-routes.test.mjs",
    "generate:legacy-api-routes": "node scripts/generate-legacy-api-routes.mjs",
    "check:legacy-api-routes": "node scripts/generate-legacy-api-routes.mjs --check",
    "test:docs-proxy": "node --test deploy/cloudflare/*.test.mjs scripts/deployment-verification.test.mjs scripts/native-deployment-fingerprint.test.mjs",
    "check:docs-proxy": "npm run test:docs-proxy && wrangler deploy --dry-run --config deploy/cloudflare/wrangler.json",
    "dev:docs-proxy": "wrangler dev --local --config deploy/cloudflare/wrangler.json --var WEBSITE_ORIGIN:https://openfga.dev",
    "verify:docs-origin": "node scripts/verify-docs-deployment.mjs --mode native --origin https://fga.mintlify.site",
    "verify:docs-proxy": "node scripts/verify-docs-deployment.mjs --mode proxy",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --port=${PORT:-3000}",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "docker:build": "docker build . -t openfga-docs-ui",
    "docker:run": "docker run -p ${PORT:-3000}:3000 openfga-docs-ui",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check src/**",
    "format:fix": "prettier --write src/**",
    "check:mintlify": "npm run check:mintlify-deployment && npm run check:mintlify-codegen && npm run validate:mintlify-navigation && npm run test:mintlify-mdx && npm run test:mintlify-content-parity && npm run validate:mintlify-components && npm run test:mintlify-component-usage && npm run test:config-page && npm run test:site-boundary && npm run check:legacy-api-routes && npm run check:docs-proxy",
    "generate:mintlify-deployment": "node scripts/native-deployment-fingerprint.mjs",
    "check:mintlify-deployment": "node scripts/native-deployment-fingerprint.mjs --check",
    "generate:mintlify-codegen": "bash docs-site/scripts/build-fga-codegen.sh",
    "check:mintlify-codegen": "bash docs-site/scripts/build-fga-codegen.sh --check && npm run test:mintlify-codegen",
    "test:mintlify-codegen": "node --test docs-site/scripts/openfga-dsl-highlight.test.mjs docs-site/scripts/validate-openfga-code-blocks.test.mjs docs-site/scripts/viewer-runtime.test.mjs docs-site/scripts/operation-codegen.test.mjs docs-site/scripts/static-request-parity.test.mjs docs-site/scripts/tuple-example-parity.test.mjs",
    "test:mintlify-components": "npm run test:mintlify-component-usage && node --test docs-site/scripts/viewer-runtime.test.mjs",
    "test:mintlify-component-usage": "node --test docs-site/scripts/validate-component-usage.test.mjs docs-site/scripts/component-fixtures.test.mjs",
    "validate:mintlify-components": "node docs-site/scripts/validate-component-usage.mjs",
    "validate:mintlify-navigation": "npm run validate:mintlify-mdx && npm run validate:mintlify-code-blocks && npm run validate:mintlify-doc-navigation && npm run validate:mintlify-api-navigation && npm run test:mintlify-navigation && npm run test:mintlify-source-parity",
    "validate:mintlify-mdx": "node docs-site/scripts/validate-mdx.mjs",
    "test:mintlify-mdx": "node --test docs-site/scripts/validate-mdx.test.mjs",
    "test:mintlify-content-parity": "node --test docs-site/scripts/live-*-parity.test.mjs",
    "validate:mintlify-code-blocks": "node docs-site/scripts/validate-openfga-code-blocks.mjs",
    "validate:mintlify-doc-navigation": "node docs-site/scripts/validate-doc-navigation.mjs",
    "validate:mintlify-api-navigation": "node docs-site/scripts/validate-api-navigation.mjs && npm run test:mintlify-api-samples",
    "test:mintlify-navigation": "node --test docs-site/scripts/navigation-structure.test.mjs docs-site/scripts/github-star-cache.test.mjs docs-site/scripts/navbar-layout.test.mjs docs-site/scripts/reader-chrome.test.mjs",
    "generate:mintlify-api-samples": "node docs-site/scripts/api-code-samples.mjs",
    "check:mintlify-api-samples": "node docs-site/scripts/api-code-samples.mjs --check",
    "test:mintlify-api-samples": "node --test docs-site/scripts/api-code-samples.test.mjs docs-site/scripts/api-code-samples.integration.test.mjs",
    "validate:mintlify-source-parity": "node docs-site/scripts/validate-source-coverage.mjs",
    "test:mintlify-source-parity": "node --test docs-site/scripts/validate-source-coverage.test.mjs",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@lottiefiles/react-lottie-player": "3.6.0",
    "@openfga/frontend-utils": "^0.2.0-beta.11",
    "@openfga/sdk": "^0.9.7",
    "@openfga/syntax-transformer": "^0.2.2",
    "assert-never": "1.4.0",
    "clsx": "2.1.1",
    "path-browserify": "1.0.1",
    "prism-react-renderer": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-feather": "2.0.10",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@mdx-js/mdx": "3.1.0",
    "@signalwire/docusaurus-plugin-llms-txt": "1.2.2",
    "@types/prismjs": "1.26.6",
    "@types/react": "18.3.9",
    "@types/react-router-dom": "5.3.3",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "docusaurus-plugin-module-alias": "0.0.2",
    "esbuild": "0.25.12",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "globals": "^17.12.0",
    "husky": "9.1.7",
    "patch-package": "8.0.1",
    "prettier": "3.9.8",
    "prismjs": "1.30.0",
    "sax": "1.5.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "wrangler": "4.134.0"
  },
  "overrides": {
    "semver": "^7.7.1"
  },
  "keywords": [
    "authorization",
    "fga",
    "fine-grained-authorization",
    "openfga",
    "openfga-docs",
    "documentation",
    "zanzibar"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com:openfga/openfga.dev"
  },
  "bugs": {
    "url": "https://github.com/openfga/openfga.dev/issues"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
